# Copy to /opt/beikexiang-warehouse/deploy/.env.production, replace every placeholder,
# and chmod 600 before running deploy/scripts/deploy.sh. Never commit the real file.
COMPOSE_PROJECT_NAME=warehouse-prod
IMAGE_PREFIX=warehouse
RELEASE_TAG=latest

# Staging validation mode: use the ECS IP over HTTP before DNS is ready.
SITE_ADDRESS=http://203.0.113.10
NODE_ENV=staging
PERSISTENCE_DRIVER=prisma
LOCAL_AUTH_BYPASS=false
API_BASE_URL=http://203.0.113.10
WEB_BASE_URL=http://203.0.113.10
SESSION_SECRET=replace-with-at-least-32-random-characters

POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=replace-with-strong-database-password
DATABASE_URL=postgresql://warehouse:replace-with-url-encoded-database-password@postgres:5432/warehouse

# Enterprise WeChat can remain unset only during staging infrastructure validation.
WE_COM_CORP_ID=
WE_COM_AGENT_ID=
WE_COM_SECRET=
WE_COM_ADMIN_IDS=
WE_COM_FINANCE_IDS=
WE_COM_CALLBACK_TOKEN=
WE_COM_ENCODING_AES_KEY=

# Final production mode (replace the active staging values above with these values):
# SITE_ADDRESS=warehouse.example.com
# NODE_ENV=production
# API_BASE_URL=https://warehouse.example.com
# WEB_BASE_URL=https://warehouse.example.com
# SESSION_SECRET=replace-with-a-unique-strong-session-secret
# WE_COM_CORP_ID=replace-with-wecom-corp-id
# WE_COM_AGENT_ID=replace-with-wecom-agent-id
# WE_COM_SECRET=replace-with-wecom-secret
# WE_COM_ADMIN_IDS=replace-with-production-admin-userid
# WE_COM_FINANCE_IDS=
# WE_COM_CALLBACK_TOKEN=replace-with-wecom-callback-token
# WE_COM_ENCODING_AES_KEY=replace-with-43-character-encoding-aes-key
