[Unit]
Description=Daily warehouse PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/beikexiang-warehouse
ExecStart=/usr/bin/env BACKUP_REASON=scheduled /opt/beikexiang-warehouse/deploy/scripts/backup.sh
TimeoutStartSec=15m
Restart=on-failure
RestartSec=5m
