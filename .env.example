# 本地开发默认使用 memory；正式环境必须显式设置为 prisma。
PERSISTENCE_DRIVER=memory
DATABASE_URL=postgresql://warehouse:warehouse@localhost:5432/warehouse
# Required by Prisma 7 when diffing/applying a migrations directory; use a separate database.
SHADOW_DATABASE_URL=postgresql://warehouse:warehouse@localhost:5432/warehouse_shadow
# 正式环境必须完整填写以下企业微信登录与审批回调参数，不要提交真实密钥。
WE_COM_CORP_ID=replace-with-wecom-corp-id
WE_COM_SECRET=replace-with-wecom-secret
WE_COM_AGENT_ID=replace-with-wecom-agent-id
# 正式环境至少填写一个企业微信 UserID，作为首位生产管理员；多个值用英文逗号分隔。
WE_COM_ADMIN_IDS=replace-with-first-production-admin-userid
WE_COM_FINANCE_IDS=
WE_COM_CALLBACK_TOKEN=replace-with-wecom-callback-token
# 必须使用企业微信提供的 43 字符无填充 EncodingAESKey（Base64 解码后正好 32 字节）。
WE_COM_ENCODING_AES_KEY=replace-with-wecom-encoding-aes-key
WEB_BASE_URL=http://localhost:5174
VITE_API_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:3001
SESSION_SECRET=replace-with-a-long-random-value
API_PORT=3001
# 仅限本地开发；正式环境设置 true 会拒绝启动。
LOCAL_AUTH_BYPASS=false
