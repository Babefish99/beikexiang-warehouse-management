# Keep memory for local API startup. prisma is intentionally fail-fast until all core inventory flows are durably wired.
PERSISTENCE_DRIVER=memory
DATABASE_URL=postgresql://warehouse:warehouse@localhost:5432/warehouse
WE_COM_CORP_ID=
WE_COM_SECRET=
WE_COM_AGENT_ID=
WE_COM_ADMIN_IDS=
WE_COM_FINANCE_IDS=
WE_COM_CALLBACK_TOKEN=
WE_COM_ENCODING_AES_KEY=
WEB_BASE_URL=http://localhost:5174
VITE_API_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:3001
SESSION_SECRET=replace-with-a-long-random-value
API_PORT=3001
# Development-only bypass. Effective only outside production and only from loopback hosts.
LOCAL_AUTH_BYPASS=false
