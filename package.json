{
  "name": "group-warehouse-management",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @warehouse/web --filter @warehouse/api dev",
    "build": "corepack pnpm --parallel --filter @warehouse/web --filter @warehouse/api build",
    "start": "corepack pnpm --filter @warehouse/api start",
    "lint": "corepack pnpm --recursive lint",
    "typecheck": "corepack pnpm --recursive typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "decimal.js": "^10.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "dotenv": "^16.6.0",
    "prisma": "^7.9.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
